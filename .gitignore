# Dependências
node_modules/

# Variáveis de ambiente — contém segredos (ANTHROPIC_API_KEY, JWT_SECRET, CODIGO_PROFESSOR)
.env

# Banco de dados local — dados de usuários; é recriado automaticamente ao iniciar o servidor
database.db
database.db-journal
database.db-wal
database.db-shm

# Python (porte para FastAPI)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
corretor.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Sistema operacional / editor
.DS_Store
Thumbs.db
.vscode/
.claude/

# Experimentos (logs e bancos temporários)
pesquisa/*.log

# Corpus do simulado — redações de alunos reais do campus, identificadas por
# prontuário. Este repositório é público, então nada disso pode ser versionado:
# são dados pessoais de estudantes, coletados para correção, não para
# publicação. Os resultados dos experimentos vão para o repositório apenas em
# forma anonimizada (ver pesquisa/anonimizar_resultados.py); a tabela que liga
# pseudônimo a prontuário mora aqui dentro e não sai da máquina.
pesquisa/corpus/simulado/
