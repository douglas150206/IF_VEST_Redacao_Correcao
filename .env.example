# Chave da API Anthropic — obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_aqui

# Segredo para gerar tokens JWT (coloque qualquer texto longo e aleatório)
JWT_SECRET=mude-para-um-segredo-longo-e-aleatorio-aqui

# Porta do servidor
PORT=3005

# URL do frontend
FRONTEND_URL=http://localhost:3000

# Código para cadastrar/promover um professor (quem gerencia o banco de temas)
CODIGO_PROFESSOR=mude-para-um-codigo-secreto
